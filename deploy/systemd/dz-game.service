[Unit]
Description=DZ C++ game web service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/dz/dz.env
WorkingDirectory=/opt/dz
ExecStart=/opt/dz/build/web_texas_webrtc ${DZ_LISTEN_HOST} ${DZ_WEB_PORT}
Restart=on-failure
RestartSec=3
User=dz
Group=dz
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/dz

[Install]
WantedBy=multi-user.target
