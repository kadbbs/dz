[Unit]
Description=DZ mediasoup signaling and SFU service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/dz/dz.env
WorkingDirectory=/opt/dz/mediasoup-server
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=3
User=dz
Group=dz
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/dz

[Install]
WantedBy=multi-user.target
