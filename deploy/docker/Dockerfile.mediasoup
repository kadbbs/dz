FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    g++ \
    make \
    python3 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY mediasoup-server/package*.json ./
RUN npm ci --omit=dev

COPY mediasoup-server/server.js ./

EXPOSE 3001
EXPOSE 40000-40100/tcp
EXPOSE 40000-40100/udp

ENV MEDIASOUP_SIGNAL_HOST=::
ENV MEDIASOUP_SIGNAL_PORT=3001
ENV MEDIASOUP_LISTEN_IP=0.0.0.0
ENV MEDIASOUP_MIN_PORT=40000
ENV MEDIASOUP_MAX_PORT=40100
CMD ["npm", "start"]
