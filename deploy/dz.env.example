# Copy to /etc/dz/dz.env and edit for your host.

# Domain used by Caddy. Use a real DNS name with AAAA record pointing to the host.
DZ_DOMAIN=dz.example.com

# C++ game/http service. Bind to ::1 when Caddy is the public entry.
# Use :: if you intentionally expose the C++ service directly.
DZ_LISTEN_HOST=::1
DZ_WEB_PORT=8080

# Private six-digit access code. Change this before starting the service.
DZ_ACCESS_CODE=739251

# mediasoup signaling WebSocket service. Caddy proxies /mediasoup to this port.
MEDIASOUP_SIGNAL_HOST=::1
MEDIASOUP_SIGNAL_PORT=3001

# mediasoup WebRTC listen/advertise settings for a public IPv6 host.
MEDIASOUP_LISTEN_IP=::
MEDIASOUP_ANNOUNCED_IP=2001:db8::10
MEDIASOUP_PREFER_IPV6=true
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
